{
  "name": "portfolio",
  "private": true,
  "packageManager": "npm@11.19.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint:content": "turbo run lint:content",
    "assets:ingest": "npm run assets:ingest -w @repo/web --",
    "assets:check": "npm run assets:check -w @repo/web",
    "assets:fetch": "npm run assets:fetch -w @repo/web --",
    "check:bundle": "npm run check:bundle -w @repo/web"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "multer": "^2.4.0",
    "qs": "^6.16.0",
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    },
    "jsdom": "30.0.1"
  }
}
