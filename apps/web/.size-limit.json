[
  {
    "name": "initial JS (non-3D)",
    "path": [
      ".next/static/chunks/*.js",
      ".next/static/chunks/app/page-*.js",
      ".next/static/chunks/app/layout-*.js",
      ".next/static/chunks/app/error-*.js",
      ".next/static/chunks/app/global-error-*.js",
      "!.next/static/chunks/framework-*.js",
      "!.next/static/chunks/polyfills-*.js",
      "!.next/static/chunks/main-!(app)*.js",
      "!.next/static/chunks/*.*.js"
    ],
    "limit": "120 kB",
    "gzip": true
  },
  {
    "name": "route pages (about, resume, work, work/[slug], not-found)",
    "path": [
      ".next/static/chunks/app/about/page-*.js",
      ".next/static/chunks/app/resume/page-*.js",
      ".next/static/chunks/app/work/page-*.js",
      ".next/static/chunks/app/work/*/page-*.js",
      ".next/static/chunks/app/not-found-*.js",
      ".next/static/chunks/app/_not-found/page-*.js"
    ],
    "limit": "3.5 kB",
    "gzip": true
  },
  {
    "name": "assembly core (three + CSM + stage + scene, lazy)",
    "path": [
      ".next/static/chunks/*.*.js",
      "!.next/static/chunks/655.*.js",
      "!.next/static/chunks/826.*.js",
      "!.next/static/chunks/models.*.js",
      "!.next/static/chunks/hero.*.js",
      "!.next/static/chunks/late-ui.*.js"
    ],
    "limit": "182 kB",
    "gzip": true
  },
  {
    "name": "late UI (contact form + Craft controls, lazy)",
    "path": [
      ".next/static/chunks/late-ui.*.js"
    ],
    "limit": "4 kB",
    "gzip": true
  },
  {
    "name": "assembly models (GLTFLoader + Meshopt + manifest, lazy)",
    "path": [
      ".next/static/chunks/models.*.js"
    ],
    "limit": "25 kB",
    "gzip": true
  },
  {
    "name": "hero engine (raw WebGL2 monolith, lazy)",
    "path": [
      ".next/static/chunks/hero.*.js"
    ],
    "limit": "14 kB",
    "gzip": true
  }
]
