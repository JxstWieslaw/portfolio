# Copy to apps/web/.env.local for local development. Never commit .env.local.
# Both values are public (NEXT_PUBLIC_*), so nothing secret belongs in this file.

# The site's own origin, for canonical URLs and JSON-LD. Falls back to the Vercel URL, then localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The API origin (apps/api on Cloud Run). Leave empty to run with the API absent; callers fall back.
# Local API: http://localhost:8080  ·  Production: https://portfolio-api-890707232965.europe-west1.run.app
NEXT_PUBLIC_API_URL=
